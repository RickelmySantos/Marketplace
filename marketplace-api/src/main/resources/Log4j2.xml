<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
    </Console>
  </Appenders>
  <Loggers>
    <!-- Logger específico para o pacote da ApiBase  -->
    <Logger name="com.br.core" level="debug" additivity="false">
      <AppenderRef ref="Console" />
    </Logger>
    <Logger name="com.br.core.configuracoes.SwaggerConfig" level="debug" additivity="false">
      <AppenderRef ref="Console" />
    </Logger>

    <Logger name="com.br.core.configuracoes.WebSecurityConfig" level="debug" additivity="false">
      <AppenderRef ref="Console" />
    </Logger>

    <Root level="info">
      <AppenderRef ref="Console" />
    </Root>
  </Loggers>
</Configuration> 